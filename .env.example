# ─────────────────────────────────────────────────────────────
#  CONFIGURACIÓN DE CONEXIÓN — Envíos Diarios
#  Copia este archivo como ".env" y rellena tus valores.
#  El archivo .env NUNCA debe subirse a GitHub.
# ─────────────────────────────────────────────────────────────

# IP o nombre de host del servidor SQL Server
DB_SERVER=192.168.x.x

# Nombre de la base de datos
DB_NAME=NombreDeTuBaseDeDatos

# Usuario de SQL Server con permisos de lectura
DB_USER=tu_usuario

# Contraseña del usuario
DB_PWD=tu_contraseña
